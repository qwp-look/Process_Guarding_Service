/* PGS Admin Qt - light theme */
QWidget {
    background-color: #f5f6f8;
    color: #1f2329;
    font-size: 9pt;
}
QMainWindow, QDialog {
    background-color: #ffffff;
}
QGroupBox {
    border: 1px solid #d0d4dc;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 8px;
    background-color: #ffffff;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #3370ff;
    font-weight: 600;
}
QLineEdit, QComboBox, QSpinBox {
    background-color: #ffffff;
    border: 1px solid #c4c9d2;
    border-radius: 4px;
    padding: 3px 6px;
    selection-background-color: #3370ff;
    selection-color: #ffffff;
}
QLineEdit:focus, QComboBox:focus {
    border: 1px solid #3370ff;
}
QPushButton {
    background-color: #ffffff;
    border: 1px solid #c4c9d2;
    border-radius: 4px;
    padding: 5px 14px;
    color: #1f2329;
}
QPushButton:hover {
    background-color: #eef1f6;
    border-color: #3370ff;
}
QPushButton:pressed {
    background-color: #dbe4ff;
}
QPushButton:default {
    background-color: #3370ff;
    color: #ffffff;
    border-color: #3370ff;
}
QPushButton:default:hover {
    background-color: #2455e0;
}
QTabWidget::pane {
    border: 1px solid #d0d4dc;
    border-radius: 4px;
    top: -1px;
}
QTabBar::tab {
    background-color: #eef1f6;
    border: 1px solid #d0d4dc;
    border-bottom: none;
    padding: 6px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #ffffff;
    color: #3370ff;
    font-weight: 600;
}
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f5f6f8;
    gridline-color: #e4e7ec;
    border: 1px solid #d0d4dc;
    border-radius: 4px;
    selection-background-color: #dbe4ff;
    selection-color: #1f2329;
}
QHeaderView::section {
    background-color: #eef1f6;
    color: #4e5969;
    padding: 5px;
    border: none;
    border-right: 1px solid #d0d4dc;
    border-bottom: 1px solid #d0d4dc;
    font-weight: 600;
}
QTextEdit {
    background-color: #ffffff;
    border: 1px solid #d0d4dc;
    border-radius: 4px;
    font-family: Consolas, "Courier New", monospace;
}
QCheckBox {
    spacing: 6px;
}
QStatusBar {
    background-color: #eef1f6;
    color: #4e5969;
}
QScrollBar:vertical {
    background: #eef1f6;
    width: 10px;
    border: none;
}
QScrollBar::handle:vertical {
    background: #c4c9d2;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #3370ff;
}
QScrollBar:horizontal {
    background: #eef1f6;
    height: 10px;
    border: none;
}
QScrollBar::handle:horizontal {
    background: #c4c9d2;
    border-radius: 5px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background: #3370ff;
}
