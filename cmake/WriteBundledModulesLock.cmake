set(out "${PGS_MODULES_LOCK_OUT}")
if(NOT out)
    message(FATAL_ERROR "PGS_MODULES_LOCK_OUT is required")
endif()

set(json "{\n  \"version\": 1,\n  \"generated_at\": \"cmake-build\",\n  \"modules\": [\n")
set(first TRUE)

foreach(name IN ITEMS sched health profile report notify metrics backup eventlog dump service_guard file_watch policy remote_agent update script_runner ppl)
    set(dll "${PGS_MODULES_ROOT}/${name}/pgs_${name}_module.dll")
    if(NOT EXISTS "${dll}")
        message(FATAL_ERROR "required module DLL missing: ${dll}")
    endif()
    file(SHA256 "${dll}" hash)
    set(risk "low")
    set(version "1.0.0")
    set(caps "[]")
    if(name STREQUAL "sched")
        set(risk "medium")
        set(caps "[\"sched.add\",\"sched.list\",\"sched.remove\",\"sched.enable\",\"sched.disable\",\"guard.register\",\"guard.unregister\",\"guard.intentional\",\"guard.policy\",\"guard.list\"]")
    elseif(name STREQUAL "health")
        set(caps "[\"health.summary\",\"health.stats\",\"guard.list\",\"event.read\"]")
    elseif(name STREQUAL "profile")
        set(risk "medium")
        set(caps "[\"profile.set\",\"profile.list\",\"profile.apply\",\"guard.policy\"]")
    elseif(name STREQUAL "report")
        set(version "1.1.0")
        set(caps "[\"report.snapshot\",\"report.backup\",\"event.read\",\"guard.list\",\"health.stats\",\"pgs.operation.create\",\"pgs.operation.update\",\"pgs.operation.finish\",\"pgs.operation.fail\",\"pgs.artifact.put\",\"pgs.artifact.get_meta\"]")
    elseif(name STREQUAL "notify")
        set(caps "[\"notify.eventlog\",\"notify.popup\",\"event.read\"]")
    elseif(name STREQUAL "metrics")
        set(caps "[\"metrics.summary\",\"metrics.prometheus\",\"health.stats\",\"guard.list\"]")
    elseif(name STREQUAL "backup")
        set(caps "[\"backup.snapshot\",\"pgs.operation.create\",\"pgs.operation.finish\",\"pgs.operation.fail\",\"pgs.artifact.put\"]")
    elseif(name STREQUAL "eventlog")
        set(caps "[\"eventlog.read\",\"event.read\"]")
    elseif(name STREQUAL "dump")
        set(risk "high")
        set(caps "[\"dump.collect\",\"pgs.operation.create\",\"pgs.operation.finish\",\"pgs.operation.fail\",\"pgs.artifact.put\"]")
    elseif(name STREQUAL "service_guard")
        set(risk "medium")
        set(caps "[\"service.query\",\"service.start\",\"service.stop\"]")
    elseif(name STREQUAL "file_watch")
        set(risk "medium")
        set(caps "[\"file.watch\",\"event.emit\"]")
    elseif(name STREQUAL "policy")
        set(risk "medium")
        set(caps "[\"policy.template\",\"guard.policy\"]")
    elseif(name STREQUAL "remote_agent")
        set(risk "medium")
        set(caps "[\"remote_agent.status\",\"guard.list\",\"health.stats\"]")
    elseif(name STREQUAL "update")
        set(risk "medium")
        set(caps "[\"update.verify\"]")
    elseif(name STREQUAL "script_runner")
        set(risk "high")
        set(caps "[\"script.run\"]")
    elseif(name STREQUAL "ppl")
        set(risk "critical")
        set(caps "[\"driver.kernel\",\"driver.sirius.load\",\"process.ppl.set\",\"process.ppl.clear\",\"ppl.set\",\"ppl.get\",\"ppl.clear\"]")
    endif()

    if(first)
        set(first FALSE)
    else()
        string(APPEND json ",\n")
    endif()
    string(APPEND json "    {\"name\":\"${name}\",\"version\":\"${version}\",\"sha256\":\"${hash}\",\"publisher\":\"PGS bundled\",\"source\":\"bundled\",\"capabilities\":${caps},\"risk\":\"${risk}\",\"trustedAt\":\"cmake-build\",\"signature_policy\":\"hash\",\"require_signed\":false}")
endforeach()

string(APPEND json "\n  ]\n}\n")
file(WRITE "${out}" "${json}")
